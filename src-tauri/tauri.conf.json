{
  "package": {
    "productName": "Pivoteer"
  },
  "build": {
    "distDir": "../build",
    "devPath": "http://localhost:4000",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "space.kasper.pivoteer",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [],
      "externalBin": [],
      "copyright": "© 2021 kasper.space",
      "category": "DeveloperTool",
      "fileAssociations": [
        {
          "ext": ["pivoteer"],
          "mime_type": ["application/pivoteer"]
        }
      ],
      "shortDescription": "",
      "longDescription": "",
      "deb": {
        "depends": []
      },
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "",
        "exceptionDomain": "",
        "signingIdentity": null,
        "entitlements": null
      },
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "updater": {
      "active": false
    },
    "allowlist": {
      "clipboard": {
        "writeText": true
      },
      "window": {
        "close": true
      },
      "shell": {
        "open": true
      },
      "dialog": {
        "open": true,
        "save": true
      }
    },
    "security": {
      "csp": "default-src blob: data: filesystem: ws: wss: http: https: tauri: 'unsafe-eval' 'unsafe-inline' 'self' img-src: 'self'"
    }
  }
}
